# Copy to .env and adjust.
# Used by the Astro hub site (site/) and by CI/link scripts.

# Your GitHub username — used by site/src/pages/index.astro to build
# repository links. Leave unset to fall back to 'your-github-username'.
GITHUB_OWNER=your-github-username

# Public URL where the hub site will be deployed
# (GitHub Pages or Vercel). Used as the Astro `site` config.
SITE_URL=http://localhost:4321

# Optional: where case-study screenshots / demo assets are served from.
ASSETS_BASE_URL=
